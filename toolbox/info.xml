<?xml version='1.0' encoding='UTF-8'?>
<!--
  Registers the toolbox with the MATLAB Help Browser. MATLAB scans the search
  path for info.xml, so this file must stay in the toolbox root rather than in
  the doc folder. help_location points at the folder holding helptoc.xml.

  The pages themselves are generated by buildUtilities/generateDocs.m and are
  not checked in. Run "buildtool doc" to produce them.
-->
<productinfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="optional">
    <matlabrelease>R2023b</matlabrelease>
    <name>Individual CMF</name>
    <type>toolbox</type>
    <icon>$toolbox/matlab/icons/bookicon.gif</icon>
    <help_location>doc</help_location>
    <help_contents_icon>$toolbox/matlab/icons/bookicon.gif</help_contents_icon>
</productinfo>
